{#
 # The showcase: Flow running on this very page, each module at the size of what it does, each with
 # what you get, a live demo, its code and its part of the manual. The page is a line of five
 # stations - Navigation, Scrolling, Sortable, Ajaxer, Cookie: its sections are stops (StickyStops),
 # the address follows the section and the panel read (Sticky), the Scrolling station's last panel is
 # a scene read sideways (StickyScenes).
 #}
{% extends 'base.html.twig' %}

{% block title %}Flow - navigation, sticky effects, stops, scenes, sortable lists, AJAX channels, consent{% endblock %}
{% block main_class %}home{% endblock %}

{% macro code(language, source, caption) %}<div class="doc-code" data-lang="{{ language }}">{% if caption %}<div class="doc-code-caption">{{ caption }}</div>{% endif %}<pre class="notranslate"><code class="language-{{ language }}">{{ source|trim }}</code></pre></div>{% endmacro %}
{% macro head(module, anchor, api, title, lead, id) %}
<header class="demo-head">
    <p class="demo-module"><span class="station"></span>{{ module }} <a href="{{ path('app_docs') }}#{{ anchor }}">manual</a> · <a href="{{ path('app_api') }}#{{ api }}">API</a></p>
    <h2{% if id %} id="{{ id }}" class="sticky-headlines-skip"{% endif %}>{{ title }}</h2>
    <p class="demo-lead">{{ lead }}</p>
</header>
{% endmacro %}
{% import _self as m %}

{% block body %}
{% set arrow_left %}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}
{% set arrow_right %}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}
{% set reload %}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M13 8a5 5 0 1 1-1.5-3.6M13 2.5v3h-3" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>{% endset %}
<section class="stop hero sticky-stop sticky-headlines" id="top" aria-labelledby="hero-title">
    <div class="wrap">
        <p class="hero-kicker"><span class="badge">@glitchr/flowjs{% if latest %} {{ latest.version }}{% endif %}</span> one library, one module per feature, no build step required</p>
        <h1 id="hero-title" class="sticky-headlines-skip">Pages that load in place.<br>Sections the scroll rests on, scenes it plays.</h1>
        <p class="hero-lead">Flow is the scroll and the navigation of server-rendered pages: links and forms that load the next page in the background, a website inside the website, a header that steps aside, scroll stops, scenes, sortable lists and trees, named AJAX channels, the cookies and the visitor's consent. Everything on this site runs on it.</p>
        <div class="hero-install">
            <code data-copy>npm install @glitchr/flowjs</code>
            <a class="button" href="{{ path('app_docs') }}">Read the manual</a>
            <a class="button is-line" href="{{ path('app_api') }}">API reference</a>
        </div>
        <nav class="line" aria-label="The modules, as stations of a line">
            <ol>
                <li><a href="#navigation"><span class="station"></span><b>Navigation</b><small><span>Transparent</span> · <span>FlowFrame</span></small></a></li>
                <li><a href="#scrolling"><span class="station"></span><b>Scrolling</b><small><span>Sticky</span> · <span>StickyStops</span> · <span>StickyScenes</span></small></a></li>
                <li><a href="#sortable"><span class="station"></span><b>Sortable</b><small><span>StickySortable</span></small></a></li>
                <li><a href="#ajaxer"><span class="station"></span><b>Ajaxer</b><small><span>Ajaxer</span></small></a></li>
                <li><a href="#cookie"><span class="station"></span><b>Cookie</b><small><span>Cookie</span></small></a></li>
            </ol>
        </nav>
        <p class="hint">This page is a line of stations: scroll and let go, or press <kbd>↓</kbd>, <kbd>Space</kbd>, <kbd>Page Down</kbd> - and watch the address follow you.</p>
    </div>
</section>

{# ── Navigation: the library's first module, the largest station; its flagship, a website in the website ── #}
<section class="stop feature is-major sticky-stop sticky-headlines" id="navigation" aria-labelledby="navigation-title">
    <div class="wrap">
        {{ m.head('Transparent · FlowFrame', 'navigation', 'transparent', 'Navigation without page loads', 'Links and forms load the next page in the background and swap it in place: one document, as many pages as you browse.', 'navigation-title') }}
        <ul class="gets">
            <li><b>History kept</b> - each page its address and entry; Back and Forward give pages back where you left them</li>
            <li><b>Head and scripts in step</b> - titles, styles, scripts of the next page; a 422 form shown in place</li>
            <li><b>A bar that never blinks</b> - shown only past 200ms, kept 400ms, styled by CSS</li>
            <li><b>A website in the website</b> - a frame that navigates on its own, the page untouched</li>
            <li><b>Prefetch, lazy loading, form memory, nested panels</b></li>
        </ul>

        <article class="demo-card is-flagship" data-demo="frame">
            <div class="flagship-head">
                <h3>A website in the website</h3>
                <p class="demo-note">Kiln &amp; Kettle is a shop that does not exist, browsed inside this page: its menu, its pages, its form, its own Back and Forward. Your page does not move - look at the counters.</p>
            </div>
            <div class="browser" data-flow-frame="tour" data-flow-frame-src="{{ path('app_demo_frame', {page: 'home'}) }}">
                <form class="browser-bar" data-flow-frame-go>
                    <span class="browser-dots" aria-hidden="true"><i></i><i></i><i></i></span>
                    <button type="button" class="browser-icon" data-flow-frame-back aria-label="Back in the frame">{{ arrow_left }}</button>
                    <button type="button" class="browser-icon" data-flow-frame-forward aria-label="Forward in the frame">{{ arrow_right }}</button>
                    <button type="button" class="browser-icon" data-flow-frame-reload aria-label="Reload the frame's page">{{ reload }}</button>
                    <input data-flow-frame-address aria-label="The frame's address" spellcheck="false" autocomplete="off">
                </form>
                <div class="browser-view" data-flow-frame-view>{% include 'site/_frame_page.html.twig' with {page: 'home', shop: shop, item: null} %}</div>
            </div>
            <dl class="frame-stats" aria-live="polite">
                <div><dt>Pages seen in the frame</dt><dd data-frame-pages>1</dd></div>
                <div><dt>This page loaded</dt><dd data-frame-documents>1 time</dd></div>
                <div><dt>Your scroll</dt><dd data-frame-scroll>did not move</dd></div>
            </dl>
            <p class="demo-note">The frame keeps its own history: your browser's Back is not the frame's - it would leave the showcase, as it leaves any page. The <i>Journal</i> is a slow page (held 1.6 s by this site's script): watch the bar under the frame's address.</p>
            <details class="demo-more">
                <summary>The markup - nothing to write in JavaScript</summary>
                {{ m.code('html', '
<div data-flow-frame="tour" data-flow-frame-src="/demo/frame/home/">
    <form data-flow-frame-go>
        <button type="button" data-flow-frame-back>←</button>
        <button type="button" data-flow-frame-forward>→</button>
        <input data-flow-frame-address>
    </form>
    <div data-flow-frame-view>…</div>
</div>
', 'index.html') }}
            </details>
        </article>

        <div class="feature-grid">
            <article class="demo-card" id="navigation-counter" data-demo="navigation">
                <h3>One document, many pages</h3>
                <dl class="counters">
                    <div><dt>Documents loaded</dt><dd data-nav-loads>1</dd></div>
                    <div><dt>Pages swapped in place</dt><dd data-nav-swaps>0</dd></div>
                </dl>
                <p class="demo-try"><a href="{{ path('app_docs') }}">The manual</a> <a href="{{ path('app_api') }}">The API</a> <a href="{{ path('app_changelog') }}">The changelog</a></p>
                <p class="demo-note">Browse and come back: the first number stays at 1. Every page after the first is fetched and swapped into <code>#page</code>.</p>
                {{ m.code('js', "
Transparent.ready({ identifier: '#page' });
window.addEventListener('transparent:load', function () {
    swaps.textContent = ++count;
});
", 'site.js') }}
            </article>

            <article class="demo-card" id="navigation-bar" data-demo="bar">
                <h3>A bar that never blinks</h3>
                <div class="switch" role="group" aria-label="The bar's look">
                    <button type="button" data-bar-look="default" aria-pressed="true">Default</button>
                    <button type="button" data-bar-look="rainbow" aria-pressed="false">Rainbow</button>
                </div>
                <p class="demo-try"><button type="button" class="button" data-bar-load="1400">A slow load (1.4s)</button> <button type="button" class="button is-line" data-bar-load="120">A fast one (0.12s)</button></p>
                <output class="bar-timeline" data-bar-timeline>Press a load: the bar's steps show here.</output>
                <p class="demo-note">A navigation faster than 200ms - most on this static site - shows no bar at all; a slower one shows it at least 400ms, then fills and fades it.</p>
                {{ m.code('css', "
:root.bar-rainbow {
    --transparent-bar-height: 4px;
    --transparent-bar-background: linear-gradient(90deg,
        #ff3b30, #ff9500, #ffcc00, #34c759, #5ac8fa, #007aff, #af52de, #ff3b30);
    --transparent-bar-size: 200% 100%;
}
", 'The look: custom properties') }}
                {{ m.code('js', "
Transparent.ready({
    progress_bar_delay: 200,    // no bar under this
    progress_bar_min: 400,      // at least this, once shown
    progress_bar_finish: 250    // the fill and the fade
});
", 'The timing') }}
            </article>
        </div>
    </div>
</section>

{# ── Scrolling: Sticky, StickyStops, StickyScenes - one station, three panels ───────────────── #}
<section class="stop feature is-major sticky-stop sticky-headlines" id="scrolling" aria-labelledby="scrolling-title">
    <div class="wrap">
        {{ m.head('Sticky · StickyStops · StickyScenes', 'sticky', 'sticky', 'Scrolling: headers, stops and scenes', 'What the scroll does on a page: a header that steps aside and an address that follows the reading, places the scroll comes to rest on, scenes it plays.', 'scrolling-title') }}
        <nav class="panel-tabs" aria-label="The three panels">
            <a href="#sticky"><b>Sticky</b> headers, the address</a>
            <a href="#stops"><b>StickyStops</b> scroll stops</a>
            <a href="#scenes"><b>StickyScenes</b> scenes</a>
        </nav>

        <div class="panel" id="sticky">
            <div class="demo-grid">
                <div class="panel-head">
                    <p class="demo-module"><span class="station"></span>Sticky <a href="{{ path('app_docs') }}#sticky">manual</a> · <a href="{{ path('app_api') }}#sticky">API</a></p>
                    <h3>Sticky headers, and an address that follows the reading</h3>
                </div>
                <div class="demo" data-demo="sticky">
                    <ul class="gets is-compact">
                        <li><b>Look at the address bar</b>: it reads <code>#sticky</code> now - the panel being read - and changes as you scroll, without a history entry.</li>
                        <li><b>Scroll down a little</b>: the header leaves; up a little, it is back (<code>.sticky-top</code>).</li>
                        <li>Also: magnets, a bottom bar, widgets, fading blocks, scroll-percent triggers, swipes, autoscroll.</li>
                    </ul>
                    <p class="demo-try"><button type="button" class="button" data-sticky-top-demo>Scroll to the top, Flow's way</button></p>
                </div>
                <div class="demo-code">
                    {{ m.code('html', '
<header class="site-head sticky-top">…</header>
<section id="scrolling" class="sticky-headlines">
    <div id="sticky">…</div>
</section>
', 'The markup') }}
                    {{ m.code('js', "
Sticky.ready({ scrollhide: true, replacehash: true });
button.addEventListener('click', function () { Sticky.scrollTo(0); });
", 'site.js') }}
                </div>
            </div>
        </div>

        <div class="panel" id="stops">
            <div class="demo-grid">
                <div class="panel-head">
                    <p class="demo-module"><span class="station"></span>StickyStops <a href="{{ path('app_docs') }}#sticky-scroll-stops">manual</a> · <a href="{{ path('app_api') }}#stickystops">API</a></p>
                    <h3>Scroll stops</h3>
                    <p class="demo-lead">Places a scroll settles on once it comes to rest - momentum included; the arrows go from one to the next, a tall one read a screen at a time.</p>
                </div>
                <div class="demo" data-demo="stops">
                    <div class="demo-bar"><span>A scroller of its own</span><output data-stops-state>stop 1 of 5</output></div>
                    <div class="demo-scroller" data-stops-scroller tabindex="0" aria-label="Five stops in a scroller of their own: scroll, or focus it and press the arrows">
                        <article class="sticky-stop card is-a"><b>1</b> A short stop</article>
                        <article class="sticky-stop card is-tall"><b>2</b> A tall stop, read a screen at a time with the keys (<code>screens</code>)<span class="tall-mark">… its second screen</span><span class="tall-mark">… its end</span></article>
                        <article class="sticky-stop card is-b"><b>3</b> A short stop</article>
                        <article class="sticky-stop card is-barely" data-sticky-short-end="0.25"><b>4</b> A stop barely taller than the scroller: its top alone (<code>shortEnd</code>)</article>
                        <article class="sticky-stop card is-c"><b>5</b> The last stop</article>
                    </div>
                    <div class="demo-bar"><span>A row, sideways (<code>data-sticky-axis="x"</code>)</span></div>
                    <div class="demo-row" data-sticky-axis="x" data-sticky-duration="450" tabindex="0" aria-label="A sideways row of stops: swipe, or focus it and press left and right">
                        {% for name in ['Navigation', 'Sticky', 'Stops', 'Scenes', 'Sortable', 'Ajaxer', 'Cookie'] %}<figure class="sticky-stop tile">{{ name }}</figure>{% endfor %}
                    </div>
                </div>
                <div class="demo-code">
                    {{ m.code('js', "
StickyStops.attach(scroller, {
    keys: true,        // the arrows, Page Up / Down, Space go stop to stop
    screens: true,     // a tall stop: a screen at a time, top to end
    duration: 600,     // a glide of its own, along the easing curve
    reach: 200         // px: only a rest near a stop is completed
});
// The page itself: its sections are stops too.
StickyStops.attach(window, { keys: true, screens: true, up: false, reach: '40vh' });
", 'stops.js') }}
                </div>
            </div>
        </div>

        <div class="panel" id="scenes">
            <div class="panel-head">
                <p class="demo-module"><span class="station"></span>StickyScenes · new in 1.6 <a href="{{ path('app_docs') }}#scenes">manual</a> · <a href="{{ path('app_api') }}#stickyscenes">API</a></p>
                <h3>Scenes the scroll plays - here, sideways</h3>
                <p class="demo-lead">Scroll the scene to the side - a trackpad, <kbd>Shift</kbd> and the wheel, a finger, or <kbd>←</kbd> <kbd>→</kbd> once it has the focus: the laptop turns and opens, step by step. The page's own scroll stays free.</p>
            </div>
            <div class="sticky-scene scene-x" data-scene-axis="x">
                <div class="sticky-scene-stage scene-stage">
                    <div class="scene-object" aria-hidden="true">
                        <div class="laptop">
                            <div class="laptop-lid">
                                <div class="laptop-screen">
                                    <div class="mini-site"><span class="mini-bar"></span><svg viewBox="0 0 64 16"><path d="M2 8h60"/><circle cx="8" cy="8" r="5"/><circle cx="32" cy="8" r="5"/><circle cx="56" cy="8" r="5"/></svg><b>Flow</b><i></i><i></i><i class="is-short"></i></div>
                                </div>
                                <div class="laptop-back"><span>Flow</span></div>
                            </div>
                            <div class="laptop-base"><div class="laptop-keys"></div><div class="laptop-pad"></div></div>
                        </div>
                    </div>
                    <div class="scene-track" data-scene-track aria-label="The laptop scene: scroll sideways, or press left and right">
                        <article class="scene-panel" data-scene-panel><div class="scene-card"><b>1. Closed</b> <span>The scene at its start: <code>--scene-progress</code> is 0.</span></div></article>
                        <article class="scene-panel" data-scene-panel><div class="scene-card"><b>2. It turns</b> <span><code>--scene-progress</code> goes 0 → 1 as the track scrolls: the device turns to face you.</span></div></article>
                        <article class="scene-panel" data-scene-panel><div class="scene-card"><b>3. It opens</b> <span>Each panel is a step (<code>data-scene-panel</code>, scroll-snap): the lid lifts.</span></div></article>
                    </div>
                    <span class="scene-hint" data-scene-hint aria-hidden="true">→</span>
                    <output class="scene-meter" data-scene-meter>progress 0.00 · step 1 of 3</output>
                </div>
            </div>
            <div class="demo-grid is-code">
                {{ m.code('html', '
<section class="sticky-scene" data-scene-axis="x">
    <div class="sticky-scene-stage">
        <div class="laptop">…</div>
        <div data-scene-track aria-label="The laptop scene">
            <article data-scene-panel>Closed</article>
            <article data-scene-panel>It turns</article>
            <article data-scene-panel>It opens</article>
        </div>
        <span data-scene-hint>→</span>
    </div>
</section>
', 'The markup') }}
                <div>
                    {{ m.code('css', "
.laptop {
    transform: rotateY(calc(-42deg + var(--scene-progress) * 42deg));
}
.laptop-lid {   /* open over the second half */
    --open: clamp(0, calc((var(--scene-progress) - .5) * 2), 1);
    transform: rotateX(calc(-90deg + var(--open) * 100deg));
}
", 'The scene is CSS') }}
                    <p class="demo-note">A vertical scene pins its stage while the page scrolls through it (<code>data-scene-length</code>), and the arrows, <kbd>Page Down</kbd> and <kbd>Space</kbd> go from step to step. With <code>prefers-reduced-motion</code> a scene shows its end, still.</p>
                </div>
            </div>
        </div>
    </div>
</section>

{# ── The smaller stations ────────────────────────────────────────────────────────────────── #}
<section class="stop feature sticky-stop sticky-headlines" id="sortable" aria-labelledby="sortable-title">
    <div class="wrap">
        {{ m.head('StickySortable', 'sortable', 'stickysortable', 'Sortable lists, and trees', 'Drag-and-drop with pointer events - mouse, pen and touch on one code path (a long press on a phone); the arrows on a handle for the keyboard. A list, or a tree whose items move between levels.', 'sortable-title') }}
        <div class="sortable-demos">
            <div class="demo" data-demo="sortable">
                <h3>A list</h3>
                <ol class="sortable" data-sortable-list>
                    {% for name in ['Navigation', 'Scrolling', 'Sortable', 'Ajaxer', 'Cookie'] %}
                    <li data-sortable-item><button type="button" class="grip" aria-label="Move {{ name }}: drag, or press the arrows">⠿</button> {{ name }}</li>
                    {% endfor %}
                </ol>
                <p class="demo-note">The order: <output data-sortable-order>Navigation, Scrolling, Sortable, Ajaxer, Cookie</output></p>
            </div>
            <div class="demo" data-demo="tree">
                <h3>A tree: chapters and their sections</h3>
                <ol class="tree" data-sortable-tree>
                    {% set book = {
                        'Getting started': ['Install', 'First page'],
                        'Navigation': ['Links and forms', 'The progress bar', 'Frames'],
                        'Scrolling': ['Headers', 'Stops'],
                        'Appendix': []
                    } %}
                    {% for chapter, sections in book %}
                    <li data-sortable-item data-id="{{ chapter|lower|replace({' ': '-'}) }}"{% if chapter == 'Appendix' %} data-sortable-leaf{% endif %}>
                        <div class="tree-row"><button type="button" class="grip" aria-label="Move {{ chapter }}: drag, or the arrows - right into the item above, left out">⠿</button><button type="button" class="tree-toggle" data-sortable-toggle aria-label="Fold {{ chapter }}"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></button><span>{{ chapter }}</span>{% if chapter == 'Appendix' %}<small>takes no section</small>{% endif %}</div>
                        {% if sections %}<ol>{% for section in sections %}
                            <li data-sortable-item data-id="{{ section|lower|replace({' ': '-'}) }}"><div class="tree-row"><button type="button" class="grip" aria-label="Move {{ section }}: drag, or the arrows - right into the item above, left out">⠿</button><span>{{ section }}</span></div></li>
                        {% endfor %}</ol>{% endif %}
                    </li>
                    {% endfor %}
                </ol>
                <p class="demo-note">Drag a section into another chapter, or out to be a chapter; on a handle, <kbd>↑</kbd> <kbd>↓</kbd> move, <kbd>→</kbd> nests under the item above, <kbd>←</kbd> takes out. Two levels at most.</p>
                <pre class="tree-out" data-sortable-tree-out aria-live="off"></pre>
            </div>
        </div>
        <div class="demo-grid is-code">
            {{ m.code('js', "
new StickySortable(list, {
    handle: '.grip',
    onChange: function (order) {
        output.textContent = order.map(function (item) {
            return item.textContent.trim();
        }).join(', ');
    }
});
", 'A list') }}
            {{ m.code('js', "
var tree = new StickySortable.Tree(book, {
    handle: '.grip',
    maxDepth: 1                 // chapters and sections, no deeper
});
book.addEventListener('sortable:change', function (e) {
    // e.detail: item, parent, index, depth, tree
    out.textContent = JSON.stringify(e.detail.tree, null, 1);
});
", 'A tree') }}
        </div>
    </div>
</section>

<section class="stop feature sticky-stop sticky-headlines" id="ajaxer" aria-labelledby="ajaxer-title">
    <div class="wrap demo-grid">
        {{ m.head('Ajaxer', 'ajaxer', 'ajaxer', 'Named AJAX channels', 'A channel is a name with its address, method, throttle, debounce, loader and retries: press quickly, one request leaves.', 'ajaxer-title') }}
        <div class="demo" data-demo="ajaxer">
            <p class="demo-try"><button type="button" class="button" data-ajaxer-send data-ajaxer-url="{{ path('app_demo_name', {n: 1}) }}">Name my project</button> <output class="ajaxer-count" data-ajaxer-count>0 asked · 0 answered</output></p>
            <p class="ajaxer-name" data-ajaxer-name aria-live="polite">Press the button.</p>
            <ol class="ajaxer-history" data-ajaxer-history aria-label="The last names"></ol>
            <details class="demo-more">
                <summary>See the response</summary>
                <pre class="demo-out" data-ajaxer-out>Nothing asked yet.</pre>
            </details>
            <p class="demo-note">Each press asks one of 64 static files at random (<code>/demo/names/&lt;n&gt;.json</code>): a real request, a different answer. Press several times quickly: the channel's throttle lets one request a second leave - the counters show it.</p>
        </div>
        <div class="demo-code">
            {{ m.code('js', "
Ajaxer.setMethod('names', 'GET');  // a static host: GET
Ajaxer.setThrottle('names', '1s'); // one a second at most
Ajaxer.setTarget('names', box);    // its loader, its classes
button.addEventListener('click', function () {
    var n = 1 + Math.floor(Math.random() * 64);
    Ajaxer.setUrl('names', '/demo/names/' + n + '.json');
    Ajaxer.send('names', {}, function (data) {
        name.textContent = data.name;  // \"Brave Otter\"
    });
});
", 'ajaxer.js') }}
        </div>
    </div>
</section>

<section class="stop feature sticky-stop sticky-headlines" id="cookie" aria-labelledby="cookie-title">
    <div class="wrap demo-grid">
        {{ m.head('Cookie', 'cookie', 'cookie', 'Cookies and consent', 'The consent panel of a real site - omnibase/consent, on this library: a cookie button in a corner, a floating panel, a switch per category, refusing as easy as accepting. This site keeps nothing about you: the panel is a demonstration.', 'cookie-title') }}
        <div class="demo" data-demo="cookie">
            <div class="cookie-demo-row">
                {% include 'site/_consent.html.twig' with {place: 'section'} %}
                <p class="demo-note">This button, or the one in the corner of the screen, opens the panel.</p>
            </div>
            <p class="demo-try">
                <button type="button" class="button" data-cookie-demo-first>See it as a first visitor</button>
                <label class="check"><input type="checkbox" data-cookie-demo-countdown> with a 10 s countdown - no answer is a refusal</label>
            </p>
            <fieldset class="cookie-where" data-cookie-demo-where>
                <legend>Where a first visitor's panel floats</legend>
                <label>Position
                    <select data-cookie-demo-position>
                        {% for p in ['bottom-left', 'bottom-center', 'bottom-right', 'top-left', 'top-center', 'top-right'] %}<option value="{{ p }}"{% if p == 'bottom-left' %} selected{% endif %}>{{ p }}</option>{% endfor %}
                    </select>
                </label>
                <label>Gutter <input type="range" min="0" max="48" step="4" value="16" data-cookie-demo-gutter> <output data-cookie-demo-gutter-out>16px</output></label>
                <label class="check"><input type="checkbox" data-cookie-demo-follow checked> next to the cookie button (it moves to that corner)</label>
            </fieldset>
            <p class="cookie-dot-line"><span class="cookie-dot" data-cookie-demo-dot aria-hidden="true"></span> <span>The answer now: <output data-cookie-demo-state>none yet</output></span></p>
        </div>
        <div class="demo-code">
            {{ m.code('js', "
Cookie.ready({
    autoOpen: false,             // this demo asks when pressed
    record: { name: 'flow-demo-consent', store: 'local' },
    countdown: { duration: '10s', action: 'refuse' },
    position: 'bottom-left',     // where it floats (1.6)
    gutter: 16,                  // from the screen's edges
    follow: '.fc-button',        // or beside the floating button
    categories: {
        necessary: { label: 'The site itself', required: true },
        demo: { label: 'A demonstration feature' }
    },
    texts: { refuse: 'Refuse', accept: 'Accept',
             refuseAll: 'Refuse all', acceptAll: 'Accept all',
             countdown: 'No answer: refused in {count} s.' }
});
Cookie.use('demo', function () { dot.on(); }, function () { dot.off(); });
", 'cookie.js') }}
        </div>
    </div>
</section>

<section class="stop end sticky-stop" id="start" aria-labelledby="start-title">
    <div class="wrap">
        <h2 id="start-title">Take what a page needs</h2>
        <div class="start-grid">
            {{ m.code('js', "
import '@glitchr/flowjs';              // everything, with the stylesheets
import '@glitchr/flowjs/navigation';   // Transparent and FlowFrame (jQuery)
import '@glitchr/flowjs/stops';        // or one module: StickyStops
import '@glitchr/flowjs/scenes';       // StickyScenes
", 'With a bundler') }}
            {{ m.code('html', '
<script src="flowjs/src/js/core.js"></script>
<script src="flowjs/src/js/stops.js"></script>
<script src="flowjs/src/js/scenes.js"></script>
', 'Without one') }}
        </div>
        <p class="start-links"><a class="button" href="{{ path('app_docs') }}">The manual, on one page</a> <a class="button is-line" href="{{ path('app_api') }}">Every function, every option</a> <a class="button is-line" href="{{ path('app_changelog') }}">What each version changed</a></p>
    </div>
</section>
{% endblock %}
