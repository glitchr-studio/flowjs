{#
 # A page the website-in-website demo browses (FlowFrame): a page of the site like any other, its
 # [data-flow-frame-page] block being what the frame shows of it.
 #}
{% extends 'base.html.twig' %}

{% set here = {departure: 'Departure', line: 'On the line', terminus: 'Terminus'}[page] %}
{% block title %}{{ here }} · Frame demo · Flow{% endblock %}
{% block main_class %}frame-demo-page{% endblock %}

{% block body %}
<div class="wrap frame-standalone">
    <p class="doc-kicker">A page of the website-in-website demo - <a href="{{ path('app_home') }}#navigation">see it in its frame</a></p>
    {% include 'site/_frame_page.html.twig' %}
</div>
{% endblock %}
