# In all environments, the following files are loaded if they exist, the latter taking precedence:
#  .env, .env.local, .env.$APP_ENV, .env.$APP_ENV.local - real environment variables win over them.

###> symfony/framework-bundle ###
APP_ENV=dev
# A static site signs nothing: the kernel needs a secret only to boot.
APP_SECRET=static-site-build-not-a-secret
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
DEFAULT_URI=http://localhost:8134
###< symfony/routing ###
